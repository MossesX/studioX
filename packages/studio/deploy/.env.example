# Copy to `.env` beside this file. `.env` is gitignored at the repo root and
# must stay that way — everything here is a credential or a host fact.

# Traefik basic auth (layer 2 of the three). Generate with:
#   htpasswd -nbB <user> '<password>'
# then DOUBLE every `$` in the result, because compose reads `$` as
# interpolation and a single `$` silently truncates the hash.
STUDIO_BASIC_AUTH=amberx:$$2y$$05$$replace.this.with.a.real.bcrypt.hash

# The shared network Traefik already watches. On this host that is Coolify's
# `coolify` network — the one `coolify-proxy` and `gizmox-web-green` sit on.
TRAEFIK_NETWORK=coolify

# The persisted directory (§2.2) — a named volume, or a host path for a mount
# you back up with the rest of the machine.
STUDIO_DATA_VOLUME=amberx-studio-data
