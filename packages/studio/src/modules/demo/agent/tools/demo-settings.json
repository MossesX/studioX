{
  "name": "demo-settings",
  "description": "Read or write Core Inspector's settings (namespace demo-settings).",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "read",
          "write"
        ],
        "description": "read every row, or write one."
      },
      "key": {
        "type": "string",
        "description": "showCapabilities — Show the capabilities card (switch)",
        "enum": [
          "showCapabilities"
        ]
      },
      "value": {
        "description": "The new value when writing; matches the row's declared kind.",
        "type": [
          "boolean",
          "number",
          "string"
        ]
      }
    },
    "required": [
      "action"
    ]
  }
}
